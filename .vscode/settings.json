{
    "cmake.generator": "Ninja",
    "cmake.buildDirectory": "${workspaceFolder}/build_${buildType}",
    "cmake.configureOnEdit": false,

    // 1. Turn off Microsoft's IntelliSense to avoid conflicts
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",

    // 2. Configure clangd to run at max performance
    "clangd.arguments": [
        // "--compile-commands-dir=${workspaceFolder}/build_${buildType}",
        "--compile-commands-dir=${workspaceFolder}",
        "--query-driver=C:/msys64/ucrt64/bin/g++.exe,C:/msys64/ucrt64/bin/gcc.exe,C:/msys64/ucrt64/bin/*",
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--function-arg-placeholders",
        "-j=4" 
    ]
}